# Frontend configuration. Copy to .env to override.
#
# Base URL of the MediShelf AI inference API. The backend is a separate Python process
# (see tools/serve_api.py) because it loads PyTorch and scikit-learn, so the frontend calls
# it cross-origin rather than through a Vite proxy.
#
# Whatever origin the frontend runs on must also appear in ALLOWED_ORIGINS in backend/.env.
VITE_API_BASE_URL="http://127.0.0.1:8000"
