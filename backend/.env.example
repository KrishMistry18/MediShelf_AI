# MediShelf AI backend configuration.
# Copy to backend/.env to override. Every value below is optional — the defaults in
# backend/app/config.py already run a working local dev server.

PROJECT_NAME="MediShelf AI"
VERSION="0.1.0"
ENVIRONMENT="development"

# DEBUG=True turns on SQLAlchemy echo, which logs every query. Leave it False unless
# you are actively debugging the data layer.
DEBUG=False

# Local SQLite default. The file is created and seeded from
# data/medicines/medicines.csv on first startup.
DATABASE_URL="sqlite:///./medishelf.db"

# Production PostgreSQL example:
# DATABASE_URL="postgresql://medishelf_user:CHANGE_ME@localhost:5432/medishelf"

# Comma-separated CORS origins. The frontend calls the API cross-origin using
# VITE_API_BASE_URL, so the deployed frontend's origin must be listed here.
# Both CORS_ORIGINS and ALLOWED_ORIGINS are supported.
# Example for staging/production:
# CORS_ORIGINS="https://medishelf.yourdomain.com,https://staging.medishelf.pages.dev"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081"
# CORS_ORIGINS="http://localhost:8080"

# Optional server binding (used by tools/serve_api.py and Docker)
HOST="127.0.0.1"
PORT="8000"
